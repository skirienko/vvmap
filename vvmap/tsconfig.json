{
  "compilerOptions": {
    "isolatedModules": false,
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "target": "es2022",
    "module": "ESNext",
    "resolveJsonModule": true,"skipLibCheck": false,
    "strict": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "types": ["geojson", "offscreencanvas"]
  },
  "include": ["src"]
}